# Copy this file to ~/.quantagent/.env and fill in your API keys
# chmod 600 ~/.quantagent/.env

# Anthropic API key (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Google API key (for Gemini models)
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter API key (unified gateway for 200+ LLMs)
# Set model to openrouter:<provider>/<model> e.g. openrouter:anthropic/claude-sonnet-4-6
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Alpha Vantage API key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Polygon API key
POLYGON_API_KEY=your_polygon_api_key_here
