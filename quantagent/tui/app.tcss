Screen {
    layout: vertical;
}

MessageView {
    height: 1fr;
    overflow-y: auto;
    padding: 0 2;
}

#empty-state {
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: $text-muted;
}

StatusBar {
    height: 1;
    background: $panel;
    padding: 0 2;
}

#status-activity {
    width: auto;
    color: $text-muted;
}

#status-activity.-running {
    color: $warning;
    text-style: bold;
}

#status-spacer {
    width: 1fr;
}

.status-segment {
    width: auto;
    color: $text-muted;
    margin-left: 2;
}

#status-model {
    color: $accent;
}

ChatInput {
    height: auto;
    max-height: 16;
    padding: 0 1;
}

#chat-input-box {
    height: auto;
    border: round $border;
    padding: 0 1;
}

#chat-input-box:focus-within {
    border: round $accent;
}

#chat-input-prompt {
    width: 2;
    color: $accent;
    text-style: bold;
}

#chat-input-field {
    border: none;
    height: 1;
    padding: 0;
    background: transparent;
}

#chat-input-field:focus {
    background: transparent;
}

#chat-input-dropdown {
    display: none;
    height: auto;
    max-height: 10;
    overflow-y: auto;
    border: round $primary;
    background: $surface;
    margin: 0 1;
}

#chat-input-dropdown > ListItem.-highlight {
    background: $primary 40%;
}

/* Modals */

ApprovalDialog, ThreadSelectorScreen, HelpScreen {
    align: center middle;
}

#approval-dialog {
    width: 60;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
    border-title-color: $accent;
    border-title-style: bold;
}

#thread-dialog {
    width: 70;
    height: auto;
    max-height: 20;
    border: round $primary;
    background: $surface;
    padding: 1 2;
    border-title-color: $accent;
    border-title-style: bold;
}

#thread-list {
    height: auto;
    max-height: 14;
    margin-bottom: 1;
}

.modal-muted {
    color: $text-muted;
}

.modal-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: center;
}

.modal-buttons Button {
    margin: 0 2;
}

/* Help modal */

#help-dialog {
    width: 84;
    max-width: 95%;
    height: 80%;
    max-height: 42;
    border: round $primary;
    background: $surface;
    padding: 1 2;
    border-title-color: $accent;
    border-title-style: bold;
}

#help-body {
    height: 1fr;
}

.help-category {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

.help-grid {
    layout: grid;
    grid-size: 2;
    grid-columns: 34 1fr;
    height: auto;
}

.help-usage {
    color: $foreground;
}

.help-description {
    color: $text-muted;
}

.help-footer {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}
