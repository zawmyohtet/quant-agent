Screen {
    layout: vertical;
}

MessageView {
    height: 1fr;
    overflow-y: auto;
    padding: 0 2;
}

StatusBar {
    height: 1;
    background: $panel;
    padding: 0 2;
}

#status-activity {
    width: auto;
    color: $text-muted;
}

#status-activity.-running {
    color: $warning;
    text-style: bold;
}

#status-spacer {
    width: 1fr;
}

.status-segment {
    width: auto;
    color: $text-muted;
    margin-left: 2;
}

#status-model {
    color: $accent;
}

ChatInput {
    height: auto;
    max-height: 16;
    border-top: solid $border;
    padding: 0 2;
}

#chat-input-dropdown {
    display: none;
    height: auto;
    max-height: 10;
    overflow-y: auto;
    border: solid $primary;
    background: $surface;
}

#chat-input-dropdown > ListItem.-highlight {
    background: $primary 40%;
}

/* Help modal */

HelpScreen {
    align: center middle;
}

#help-dialog {
    width: 84;
    max-width: 95%;
    height: 80%;
    max-height: 42;
    border: round $primary;
    background: $surface;
    padding: 1 2;
    border-title-color: $accent;
    border-title-style: bold;
}

#help-body {
    height: 1fr;
}

.help-category {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

.help-grid {
    layout: grid;
    grid-size: 2;
    grid-columns: 34 1fr;
    height: auto;
}

.help-usage {
    color: $foreground;
}

.help-description {
    color: $text-muted;
}

.help-footer {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}
