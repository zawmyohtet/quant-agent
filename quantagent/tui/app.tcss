Screen {
    layout: vertical;
}

MessageView {
    height: 1fr;
    overflow-y: auto;
    padding: 0 2;
}

StatusBar {
    height: 1;
    background: $surface;
    padding: 0 2;
    margin-top: 1;
}

#status-info {
    width: 100%;
    color: $text-muted;
}

ChatFooter {
    height: 1;
    background: $surface;
    padding: 0 2;
    margin-top: 1;
}

#footer-loading {
    width: auto;
    color: $text-muted;
}

#footer-spacer {
    width: 1fr;
}

#footer-hint {
    width: auto;
    color: $text-muted;
}

ChatInput {
    height: auto;
    max-height: 6;
    border-top: solid $border;
    padding: 0 2;
}

#chat-input-dropdown {
    display: none;
    height: auto;
    max-height: 8;
    border: solid $primary;
    background: $surface;
}
