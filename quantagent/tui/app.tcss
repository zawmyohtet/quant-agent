Screen {
    layout: vertical;
}

MessageView {
    height: 1fr;
    overflow-y: auto;
    padding: 0 2;
}

StatusBar {
    height: 1;
    background: $panel;
    padding: 0 2;
}

#status-activity {
    width: auto;
    color: $text-muted;
}

#status-activity.-running {
    color: $warning;
    text-style: bold;
}

#status-spacer {
    width: 1fr;
}

.status-segment {
    width: auto;
    color: $text-muted;
    margin-left: 2;
}

#status-model {
    color: $accent;
}

ChatInput {
    height: auto;
    max-height: 16;
    border-top: solid $border;
    padding: 0 2;
}

#chat-input-dropdown {
    display: none;
    height: auto;
    max-height: 10;
    overflow-y: auto;
    border: solid $primary;
    background: $surface;
}

#chat-input-dropdown > ListItem.-highlight {
    background: $primary 40%;
}
